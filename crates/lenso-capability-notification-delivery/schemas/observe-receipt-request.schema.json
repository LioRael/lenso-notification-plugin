{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "delivery_id", "attempt_id", "run_id", "kind", "observed_at", "remote_id", "digest"],
  "properties": {
    "observation_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "delivery_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "kind": { "type": "string", "enum": ["delivered", "bounced", "rejected"] },
    "observed_at": { "type": "string", "format": "date-time", "minLength": 1, "maxLength": 64 },
    "remote_id": { "type": "string", "minLength": 1, "maxLength": 320 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
