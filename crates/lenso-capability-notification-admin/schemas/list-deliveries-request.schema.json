{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "$ref": "#/$defs/DeliveryStatus" }
  },
  "$defs": {
    "DeliveryStatus": { "type": "string", "enum": ["queued", "attempting", "accepted", "retry_scheduled", "delivered", "failed", "delivery_unknown"] }
  }
}
