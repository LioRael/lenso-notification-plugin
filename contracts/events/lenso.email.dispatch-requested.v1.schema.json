{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/contracts/lenso.email.dispatch-requested.v1.schema.json",
  "title": "lenso.email.dispatch-requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliveryId", "attemptId", "functionRunId", "idempotencyKey", "channel", "recipient", "message", "context"],
  "properties": {
    "deliveryId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "functionRunId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 240 },
    "channel": { "const": "email" },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": { "address": { "type": "string", "minLength": 3, "maxLength": 320 } }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "locale", "subject", "text", "html", "contentDigest"],
      "properties": {
        "templateId": { "const": "organization-invitation" },
        "templateVersion": { "const": "v1" },
        "locale": { "enum": ["en", "en-US"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 998 },
        "text": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "html": { "type": "string", "minLength": 1, "maxLength": 262144 },
        "contentDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlationId"],
      "properties": { "correlationId": { "type": "string", "minLength": 1, "maxLength": 240 } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
