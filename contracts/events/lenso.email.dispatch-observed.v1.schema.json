{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenso.dev/contracts/lenso.email.dispatch-observed.v1.schema.json",
  "title": "lenso.email.dispatch-observed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliveryId", "attemptId", "functionRunId", "outcome", "provider", "observedAt", "remoteReceipt", "failure"],
  "properties": {
    "deliveryId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "functionRunId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "outcome": { "enum": ["accepted", "temporary_failure", "permanent_failure", "delivery_unknown"] },
    "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
    "observedAt": { "type": "string", "format": "date-time" },
    "remoteReceipt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["remoteId", "source", "digest"],
          "properties": {
            "remoteId": { "type": "string", "minLength": 1, "maxLength": 320 },
            "source": { "type": "string", "minLength": 1, "maxLength": 160 },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "classification", "retryAfterMs"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 160 },
            "classification": { "type": "string", "minLength": 1, "maxLength": 160 },
            "retryAfterMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400000 }
          }
        }
      ]
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
